{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "customer-discovery",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 13 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "customer-discovery",
      // Replace after `wrangler d1 create customer-discovery`
      "database_id": "1a17a6a7-7874-4de1-94b7-9c69454ec6af",
      "migrations_dir": "migrations"
    },
  ],
  "routes": [
    {
      "pattern": "discovery.trywirebound.com",
      "custom_domain": true
    }
  ],
  // Platform-level guard: the Worker can only email this address. Set it to your verified address.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": [
        "russel@trywirebound.com"
      ]
    }
  ],
  // Non-secret config only. Secrets go through `wrangler secret put`.
  "vars": {
    "DAILY_BUDGET_USD": "3",
    "CLAUDE_MODEL": "claude-haiku-4-5",
    // Sender on a domain verified in Cloudflare Email Service
    "DIGEST_FROM": "russel@trywirebound.com"
  },
  // Persist console.log output and invocation logs so cron runs can be inspected after the fact.
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
}